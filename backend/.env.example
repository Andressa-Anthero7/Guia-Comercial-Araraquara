# Inject these into the API/worker environment. This file is not loaded automatically.
DEFAULT_FROM_EMAIL="Guia Comercial Araraquara <nao-responda@guiacomararaquara.com.br>"
GCA_AUTH_ORIGIN=https://guiacomararaquara.com.br
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Enable capture only after migrations; delivery only after SMTP/domain validation.
GCA_EMAIL_EVENTS_ENABLED=false
GCA_EMAIL_DELIVERY_ENABLED=false
